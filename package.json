{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:worker": "bun run src/worker.ts",
    "start:publisher": "bun run src/publisher.ts",
    "start:reference-reprocessor": "bun run src/reference-reprocessor.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --max-concurrency=1 test/integration",
    "test:distributed-workers": "docker compose --profile distributed-test up --build --abort-on-container-exit --exit-code-from distributed-test-runner distributed-test-runner worker-test",
    "test:distributed-workers:run": "bun test --max-concurrency=1 test/distributed/worker-replicas.spec.ts",
    "test:load": "bun run scripts/load-test.ts",
    "migration:create": "bun ./node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "bun ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun ./node_modules/@mikro-orm/cli/cli.js migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1125.0",
    "@mikro-orm/core": "7.1.14",
    "@mikro-orm/decorators": "7.1.14",
    "@mikro-orm/migrations": "7.1.14",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.14",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.2.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@mikro-orm/cli": "7.1.14",
    "@types/bun": "1.3.4",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "lodash": "4.18.0",
    "path-to-regexp": "8.4.2"
  }
}
