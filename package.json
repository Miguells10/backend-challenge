{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:worker": "bun run src/worker.ts",
    "start:publisher": "bun run src/publisher.ts",
    "start:reference-reprocessor": "bun run src/reference-reprocessor.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1125.0",
    "@mikro-orm/core": "7.1.14",
    "@mikro-orm/decorators": "7.1.14",
    "@mikro-orm/migrations": "7.1.14",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.14",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.2.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@mikro-orm/cli": "7.1.14",
    "@types/bun": "1.3.4",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
