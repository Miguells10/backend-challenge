PORT=3000
# URL de conexão com o PostgreSQL.
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
# Banco exclusivo para testes de integração. Nunca aponte esta variável para o banco da API local.
TEST_DATABASE_URL=postgresql://wagering:wagering@localhost:5433/wagering_test
# Filas exclusivas dos testes de integração; nunca reutilize as filas da API local.
TEST_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-test.fifo
TEST_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-test-dlq.fifo
TEST_WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events-test.fifo
# Endpoint do SQS; no desenvolvimento local, aponta para o LocalStack.
SQS_ENDPOINT=http://localhost:4566

# Região e credenciais usadas pelo cliente AWS/LocalStack local.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Fila FIFO que recebe transações financeiras dos provedores.
WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# Fila de quarentena para payloads inválidos ou mensagens que excederam retries.
WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Fila FIFO para eventos já confirmados e publicados pela outbox.
WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Política do reprocessador de REFUND/ROLLBACK sem a transação de referência.
# Todos os tempos abaixo estão em milissegundos.
# Espera antes da primeira tentativa de encontrar a referência.
PENDING_REFERENCE_INITIAL_DELAY_MS=5000
# Teto do backoff exponencial entre as tentativas seguintes.
PENDING_REFERENCE_MAX_DELAY_MS=300000
# Ao atingir esta quantidade de tentativas, a pendência é rejeitada como REFERENCE_NOT_FOUND.
PENDING_REFERENCE_MAX_ATTEMPTS=5
# Máximo de pendências buscadas por ciclo do reprocessador.
PENDING_REFERENCE_BATCH_SIZE=10
# Intervalo de espera quando não existe uma pendência pronta para reprocessar.
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
